PORT=3456
YAML_DIR=./data

# Database type: sqlite (default) or mysql
DB_TYPE=sqlite

# SQLite settings (used when DB_TYPE=sqlite)
DB_PATH=./data/testrix.db

# MySQL settings (used when DB_TYPE=mysql)
# MYSQL_URL=mysql://user:password@127.0.0.1:3306/testrix
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=testrix
MYSQL_CONNECTION_LIMIT=10

SESSION_SECRET=change-this-secret-in-production
PUBLIC_BASE_URL=http://localhost:3456

# Set to false when deployed in a local network to skip email verification codes
REQUIRE_EMAIL_VERIFICATION=true

# Set to false to disable the End User License Agreement requirement on registration
REQUIRE_EULA=true

# SMTP settings for registration verification emails (required when REQUIRE_EMAIL_VERIFICATION=true)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=Testrix Share <noreply@example.com>
